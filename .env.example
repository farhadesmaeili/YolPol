# Deployment/runtime (server-only, non-secret).
# Next.js sets NODE_ENV. Staging and Production both run with NODE_ENV=production.
# Use development locally, staging only on Staging, and production only on Production.
YOLPOL_DEPLOYMENT_ENVIRONMENT=development
# Required HTTPS application origin in Staging/Production; omit in local Development.
# Staging example: https://staging.yolpol.com; Production: https://yolpol.com.
YOLPOL_APP_ORIGIN=

# PostgreSQL (server-only; DATABASE_URL and POSTGRES_PASSWORD are sensitive).
# These Compose inputs and URL are for local Development only. Use distinct roles,
# databases, and credentials for Staging and Production; never commit those values.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=yolpol
POSTGRES_USER=yolpol
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://yolpol:change-me-for-local-development@127.0.0.1:5432/yolpol

# Staff/web security and public Telegram metadata.
# Public-safe bot username used only to construct validated t.me Staff links.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourYolpolBot

# Telegram secrets (server-only). Configure exactly one value or file variable per
# credential. The _FILE form points to a mounted secret file; dual configuration fails.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_FILE=
# Server/tooling-only HTTPS origin used only by Telegram webhook management commands.
TELEGRAM_WEBHOOK_PUBLIC_ORIGIN=https://your-public-webhook-host.example

# AI/provider configuration (server-only).
# Invalid values fail closed by disabling AI automation.
YOLPOL_AI_AUTOMATION_EMERGENCY_DISABLED=false
# Configure exactly one Groq value or file variable. The _FILE form points to a
# mounted secret file; missing, unreadable, empty, or dual configuration fails safely.
GROQ_API_KEY=
GROQ_API_KEY_FILE=

# Rate limiting (server-only, non-secret, process-local).
# Single-process global Inquiry limiter. Multi-replica deployments require a shared limiter.
INQUIRY_RATE_LIMIT_MAX_REQUESTS=60
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=600

# Dedicated process-local Staff login limiter. Multi-replica deployments require a shared limiter.
STAFF_LOGIN_RATE_LIMIT_MAX_REQUESTS=20
STAFF_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Dedicated process-local authenticated Staff reply limiter. Multi-replica deployments require a shared limiter.
STAFF_REPLY_RATE_LIMIT_MAX_REQUESTS=120
STAFF_REPLY_RATE_LIMIT_WINDOW_SECONDS=60

# Dedicated process-local authenticated AI Operations policy mutation limiter.
STAFF_AI_OPERATIONS_RATE_LIMIT_MAX_REQUESTS=30
STAFF_AI_OPERATIONS_RATE_LIMIT_WINDOW_SECONDS=60

# Dedicated process-local authenticated AI Provider Registry mutation limiter.
STAFF_AI_PROVIDER_REGISTRY_RATE_LIMIT_MAX_REQUESTS=30
STAFF_AI_PROVIDER_REGISTRY_RATE_LIMIT_WINDOW_SECONDS=60

# Dedicated process-local Customer and Staff conversation typing limiter.
CONVERSATION_TYPING_RATE_LIMIT_MAX_REQUESTS=120
CONVERSATION_TYPING_RATE_LIMIT_WINDOW_SECONDS=60

# Development-only. Do not configure these in Staging or Production.
# Optional local-development polling interval for pnpm dev:inquiry-notifications (500-60000 ms).
INQUIRY_NOTIFICATION_DEV_POLL_MS=2000
# Optional local Development origin used for LAN/device testing. This remains the
# sole Development override; YOLPOL_APP_ORIGIN is only for Staging/Production.
YOLPOL_DEV_ORIGIN=http://your-ip-or-domain:3000

# Integration-test-only. Never reuse Development, Staging, or Production credentials.
POSTGRES_TEST_PORT=55432
POSTGRES_TEST_DB=yolpol_integration
POSTGRES_TEST_USER=yolpol_test
POSTGRES_TEST_PASSWORD=local-integration-only
INTEGRATION_DATABASE_URL=postgresql://yolpol_test:local-integration-only@127.0.0.1:55432/yolpol_integration
