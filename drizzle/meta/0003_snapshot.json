        "inquiries_id_format_check": {
          "name": "inquiries_id_format_check",
          "value": "\"inquiries\".\"id\" ~ '^[A-Za-z0-9_-]{1,128}$'"
        },
        "inquiries_status_check": {
          "name": "inquiries_status_check",
          "value": "\"inquiries\".\"status\" in ('received','processing','contacted','quoted','won','lost','spam')"
        },
        "inquiries_preferred_contacts_check": {
          "name": "inquiries_preferred_contacts_check",
          "value": "\"inquiries\".\"preferred_contact_methods\" in (array['email']::varchar[], array['whatsapp']::varchar[], array['telegram']::varchar[], array['phone']::varchar[], array['email','whatsapp']::varchar[], array['email','telegram']::varchar[], array['whatsapp','telegram']::varchar[], array['email','whatsapp','telegram']::varchar[])"
        },
        "inquiries_whatsapp_contact_check": {
          "name": "inquiries_whatsapp_contact_check",
          "value": "\"inquiries\".\"whatsapp_phone\" is null or 'whatsapp' = any(\"inquiries\".\"preferred_contact_methods\")"
        },
        "inquiries_telegram_contact_check": {
          "name": "inquiries_telegram_contact_check",
          "value": "\"inquiries\".\"telegram_username\" is null or 'telegram' = any(\"inquiries\".\"preferred_contact_methods\")"
        },
        "inquiries_source_locale_check": {
          "name": "inquiries_source_locale_check",
          "value": "\"inquiries\".\"source_locale\" in ('en','tr','fa','ar')"
        },
        "inquiries_privacy_accepted_check": {
          "name": "inquiries_privacy_accepted_check",
          "value": "\"inquiries\".\"privacy_accepted\" = true"
        },
        "inquiries_destination_city_check": {
          "name": "inquiries_destination_city_check",
          "value": "\"inquiries\".\"destination_city\" is null or \"inquiries\".\"destination_country\" is not null"
        },
        "inquiries_message_length_check": {
          "name": "inquiries_message_length_check",
          "value": "\"inquiries\".\"message\" is null or char_length(\"inquiries\".\"message\") between 1 and 2000"
        },
        "inquiries_timestamps_check": {
          "name": "inquiries_timestamps_check",
          "value": "\"inquiries\".\"updated_at\" >= \"inquiries\".\"created_at\" and \"inquiries\".\"privacy_accepted_at\" <= \"inquiries\".\"created_at\""
        }
      },
